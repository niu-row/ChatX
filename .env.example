# HTTP endpoint
CHATGPTX_HOST=127.0.0.1
CHATGPTX_PORT=3210

# Allowed filesystem roots. Use the platform delimiter (`;` on Windows, `:` on macOS/Linux).
# If omitted, the current working directory is the only allowed filesystem root.
# Windows example: D:\Projects;D:\Documents
# Linux/macOS example: /home/me/projects:/tmp/work
CHATGPTX_ROOTS=

# Optional settings directory. Defaults to <cwd>/.chatgptx.
# Stores settings.json, the Windows DPAPI Runtime Key blob, the disabled Git-hook directory, and tunnel health URL state.
CHATGPTX_SETTINGS_DIR=

# Disable path-root checks entirely. This gives filesystem tools full access as the current OS user.
CHATGPTX_FULL_ACCESS=false

# Shell execution is intentionally enabled for this project. Set false to disable run_command and process tools.
CHATGPTX_ENABLE_SHELL=false

# Optional shared bearer token for direct HTTP deployments. Leave empty when using a trusted local tunnel
# that does not inject a static Authorization header.
CHATGPTX_AUTH_TOKEN=

# Limits
CHATGPTX_MAX_FILE_BYTES=10485760
CHATGPTX_MAX_COMMAND_OUTPUT_CHARS=200000
CHATGPTX_MAX_PROCESS_BUFFER_CHARS=1000000
CHATGPTX_MAX_MCP_RESPONSE_BYTES=2097152
CHATGPTX_MAX_RUNNING_PROCESSES=16
CHATGPTX_DEFAULT_COMMAND_TIMEOUT_MS=120000
CHATGPTX_MAX_SEARCH_FILES=10000
