{
  "name": "chatx",
  "version": "0.3.0",
  "private": true,
  "description": "Windows desktop bridge connecting ChatGPT Secure MCP Tunnel to Desktop Commander",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "desktop:prepare": "node scripts/prepare-desktop-bundle.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build --no-bundle",
    "desktop:installer": "npm run desktop:prepare && node scripts/build-installer.mjs",
    "desktop:release": "npm run desktop:prepare && node scripts/build-installer.mjs --publish",
    "desktop:verify": "npm run desktop:prepare && npm run test:runtime",
    "test:desktop": "node scripts/desktop-static-test.mjs",
    "test:installer": "node scripts/installer-runtime-test.mjs",
    "test:bridge": "node scripts/bridge-smoke-test.mjs",
    "test:runtime": "npm run test:installer && npm run test:bridge",
    "test:version": "node scripts/version-consistency-test.mjs",
    "test": "node scripts/version-consistency-test.mjs && node scripts/desktop-static-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
