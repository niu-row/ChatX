{
  "name": "chatx",
  "version": "0.2.0",
  "private": true,
  "description": "Local full-capability MCP server for ChatGPT custom connectors",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "console": "npm run build && node dist/index.js --open-ui",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop-bundle.mjs",
    "desktop:dev": "npm run build && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build --no-bundle",
    "desktop:installer": "npm run desktop:prepare && tauri build --bundles nsis",
    "start:stdio": "node dist/index.js --stdio",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:settings": "npm run build && node scripts/settings-test.mjs",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:desktop": "node scripts/desktop-static-test.mjs",
    "benchmark": "npm run build && node scripts/performance.mjs",
    "test": "npm run check && npm run build && node scripts/settings-test.mjs && node scripts/smoke.mjs && node scripts/desktop-static-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
