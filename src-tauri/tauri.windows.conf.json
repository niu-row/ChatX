{
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/node.exe": "node.exe",
      "resources/tunnel-client.exe": "tunnel-client.exe",
      "resources/desktop-commander-launcher.mjs": "desktop-commander-launcher.mjs",
      "resources/runtime-manifest.json": "runtime-manifest.json",
      "resources/tunnel-client-LICENSE.txt": "tunnel-client-LICENSE.txt",
      "resources/tunnel-client-NOTICE.txt": "tunnel-client-NOTICE.txt",
      "resources/DesktopCommander-LICENSE.txt": "DesktopCommander-LICENSE.txt",
      "resources/desktop-commander": "desktop-commander"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "./windows/installer-template.nsi",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
