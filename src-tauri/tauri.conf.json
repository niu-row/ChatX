{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatX",
  "version": "0.2.0",
  "identifier": "com.chatgptx.local",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChatX 本地控制台",
        "width": 1180,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/chatgptx-backend.mjs": "chatgptx-backend.mjs",
      "resources/node.exe": "node.exe",
      "resources/tunnel-client.exe": "tunnel-client.exe",
      "resources/runtime-manifest.json": "runtime-manifest.json",
      "resources/tunnel-client-LICENSE.txt": "tunnel-client-LICENSE.txt",
      "resources/tunnel-client-NOTICE.txt": "tunnel-client-NOTICE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
