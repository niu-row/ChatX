{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatX",
  "version": "0.4.10",
  "identifier": "com.chatgptx.local",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChatX 本地控制台",
        "width": 1180,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true
  }
}
